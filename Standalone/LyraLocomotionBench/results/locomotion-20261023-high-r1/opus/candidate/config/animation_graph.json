{
 "schema_version": 1,
 "status": "implemented_static_plan_graph",
 "semantics": "Declarative graph consumed by src/controller.py (LocomotionController). Conditions are named predicates implemented in src/locomotion_conditions.py; the controller refuses to start if the graph references an unknown predicate, node, asset or sync group. Not a UE AnimGraph serialization.",
 "asset_table": "assets/authored_assets.json",
 "parameters": {
  "moving_speed_min_cm_s": 10.0,
  "idle_speed_max_cm_s": 5.0,
  "accel_input_eps_cm_s2": 1.0,
  "gait_walk_to_jog_speed_cm_s": 470.0,
  "gait_jog_to_walk_speed_cm_s": 420.0,
  "cardinal_deadzone_deg": 15.0,
  "cardinal_fwd_half_angle_deg": 50.0,
  "cardinal_bwd_half_angle_deg": 130.0,
  "acceleration_semantics": "input_intent",
  "default_braking_deceleration_cm_s2": 1400.0,
  "braking_estimate_smoothing": 0.25,
  "pivot_min_speed_cm_s": 150.0,
  "pivot_min_accel_cm_s2": 300.0,
  "pivot_min_angle_deg": 120.0,
  "pivot_exit_after_pivot_s": 0.25,
  "pivot_exit_direction_tolerance_deg": 35.0,
  "start_exit_speed_ratio": 0.9,
  "start_exit_max_time_ratio": 0.85,
  "start_max_direction_change_deg": 60.0,
  "distance_match_min_play_rate": 0.6,
  "distance_match_max_play_rate": 1.6,
  "cycle_play_rate_min": 0.8,
  "cycle_play_rate_max": 1.25,
  "orientation_warp_max_deg": 50.0,
  "orientation_warp_bones": ["pelvis", "spine_01", "spine_02", "spine_03"],
  "turn_trigger_deg": 60.0,
  "turn_select_180_above_deg": 130.0,
  "turn_min_idle_time_s": 0.1,
  "root_yaw_offset_max_deg": 180.0,
  "root_yaw_offset_moving_blend_out_s": 0.2,
  "aim_spine_bones": ["spine_01", "spine_02", "spine_03", "spine_04", "spine_05", "neck_01"],
  "aim_spine_weights": [0.1, 0.15, 0.2, 0.2, 0.2, 0.15],
  "aim_yaw_limit_deg": 90.0,
  "blend_epsilon": 0.001
 },
 "nodes": [
  {"id": "input", "kind": "frame_input",
   "fields": ["dt_seconds", "velocity_world_cm_s", "acceleration_world_cm_s2", "actor_yaw_degrees", "aim_yaw_degrees"]},
  {"id": "kinematics", "kind": "derived_values",
   "outputs": ["speed_cm_s", "local_velocity_angle_deg", "cardinal", "gait", "accel_along_velocity_cm_s2", "accel_velocity_angle_deg", "braking_deceleration_estimate_cm_s2", "root_yaw_offset_deg", "aim_offset_deg"]},
  {"id": "locomotion_sm", "kind": "state_machine", "initial_state": "idle",
   "states": [
    {"id": "idle", "player_node": "player_idle"},
    {"id": "start", "player_node": "player_start"},
    {"id": "cycle", "player_node": "player_cycle"},
    {"id": "stop", "player_node": "player_stop"},
    {"id": "pivot", "player_node": "player_pivot"},
    {"id": "turn_in_place", "player_node": "player_turn"}
   ],
   "transitions": [
    {"from": "idle", "to": "start", "condition": "wants_to_move", "blend_time_s": 0.15, "priority": 0},
    {"from": "idle", "to": "turn_in_place", "condition": "turn_needed", "blend_time_s": 0.2, "priority": 1},
    {"from": "turn_in_place", "to": "start", "condition": "wants_to_move", "blend_time_s": 0.2, "priority": 0},
    {"from": "turn_in_place", "to": "idle", "condition": "turn_finished", "blend_time_s": 0.25, "priority": 1},
    {"from": "start", "to": "stop", "condition": "wants_to_stop", "blend_time_s": 0.2, "priority": 0},
    {"from": "start", "to": "pivot", "condition": "pivot_requested", "blend_time_s": 0.2, "priority": 1},
    {"from": "start", "to": "cycle", "condition": "start_finished", "blend_time_s": 0.25, "priority": 2},
    {"from": "cycle", "to": "stop", "condition": "wants_to_stop", "blend_time_s": 0.2, "priority": 0},
    {"from": "cycle", "to": "pivot", "condition": "pivot_requested", "blend_time_s": 0.2, "priority": 1},
    {"from": "pivot", "to": "stop", "condition": "wants_to_stop", "blend_time_s": 0.2, "priority": 0},
    {"from": "pivot", "to": "cycle", "condition": "pivot_finished", "blend_time_s": 0.25, "priority": 1},
    {"from": "stop", "to": "start", "condition": "wants_to_move", "blend_time_s": 0.2, "priority": 0},
    {"from": "stop", "to": "idle", "condition": "stop_finished", "blend_time_s": 0.3, "priority": 1}
   ]},
  {"id": "player_idle", "kind": "asset_player", "state": "idle", "selector": "sel_idle",
   "time_mode": "clock_loop", "loop": true, "sync_group": null},
  {"id": "player_start", "kind": "asset_player", "state": "start", "selector": "sel_start",
   "time_mode": "distance_match", "distance_curve": "distance_traveled_cm", "loop": false, "sync_group": null},
  {"id": "player_cycle", "kind": "asset_player", "state": "cycle", "selector": "sel_cycle",
   "time_mode": "speed_scaled_clock", "loop": true, "sync_group": "locomotion_cycle"},
  {"id": "player_stop", "kind": "asset_player", "state": "stop", "selector": "sel_stop",
   "time_mode": "distance_match", "distance_curve": "distance_to_stop_cm", "loop": false, "sync_group": null},
  {"id": "player_pivot", "kind": "asset_player", "state": "pivot", "selector": "sel_pivot",
   "time_mode": "distance_match_to_marker", "distance_curve": "signed_distance_to_pivot_cm", "loop": false, "sync_group": null},
  {"id": "player_turn", "kind": "asset_player", "state": "turn_in_place", "selector": "sel_turn",
   "time_mode": "clock_once", "curve": "remaining_turn_yaw_deg", "loop": false, "sync_group": null},
  {"id": "sel_idle", "kind": "asset_selector", "keys": [],
   "table": {"default": "idle_ready"},
   "fallback": {"idle_ready": {"policy": "substitute", "asset_id": "ready_pose_static", "reason": "idle animation samples missing; static ready pose derived from sampled start/stop/turn boundary frames"}}},
  {"id": "sel_start", "kind": "asset_selector", "keys": ["gait", "cardinal"],
   "table": {
    "walk": {"fwd": "walk_fwd_start", "bwd": "walk_bwd_start", "left": "walk_left_start", "right": "walk_right_start"},
    "jog": {"fwd": "jog_fwd_start", "bwd": "jog_bwd_start", "left": "jog_left_start", "right": "jog_right_start"}},
   "fallback": {"*": {"policy": "skip_state", "target_state": "cycle", "reason": "directional start samples missing; enter matching cycle directly with crossfade"}}},
  {"id": "sel_cycle", "kind": "asset_selector", "keys": ["gait", "cardinal"],
   "table": {
    "walk": {"fwd": "walk_fwd_cycle", "bwd": "walk_bwd_cycle", "left": "walk_left_cycle", "right": "walk_right_cycle"},
    "jog": {"fwd": "jog_fwd_cycle", "bwd": "jog_bwd_cycle", "left": "jog_left_cycle", "right": "jog_right_cycle"}},
   "fallback": {}},
  {"id": "sel_stop", "kind": "asset_selector", "keys": ["gait", "cardinal"],
   "table": {
    "walk": {"fwd": "walk_fwd_stop", "bwd": "walk_bwd_stop", "left": "walk_left_stop", "right": "walk_right_stop"},
    "jog": {"fwd": "jog_fwd_stop", "bwd": "jog_bwd_stop", "left": "jog_left_stop", "right": "jog_right_stop"}},
   "fallback": {"*": {"policy": "substitute_timed_blend", "asset_id": "ready_pose_static", "reason": "directional stop samples missing; crossfade cycle to static ready pose over predicted stopping time"}}},
  {"id": "sel_pivot", "kind": "asset_selector", "keys": ["gait", "cardinal"],
   "key_note": "cardinal = entry (pre-pivot) local velocity direction; jog_fwd_pivot data shows entry 0 deg -> exit 180 deg",
   "table": {
    "walk": {"fwd": "walk_fwd_pivot", "bwd": "walk_bwd_pivot", "left": "walk_left_pivot", "right": "walk_right_pivot"},
    "jog": {"fwd": "jog_fwd_pivot", "bwd": "jog_bwd_pivot", "left": "jog_left_pivot", "right": "jog_right_pivot"}},
   "fallback": {"*": {"policy": "skip_state", "target_state": "cycle", "reason": "pivot samples missing; crossfade to the cycle of the new direction"}}},
  {"id": "sel_turn", "kind": "asset_selector", "keys": ["turn_side", "turn_size"],
   "table": {"left": {"90": "turn_in_place_left_90", "180": "turn_in_place_left_180"},
             "right": {"90": "turn_in_place_right_90", "180": "turn_in_place_right_180"}},
   "fallback": {
    "turn_in_place_left_180": {"policy": "substitute", "asset_id": "turn_in_place_right_180", "reason": "left 180 missing; right 180 reaches the same facing", "turn_yaw_scale_mode": "match_requested"},
    "turn_in_place_right_90": {"policy": "substitute", "asset_id": "turn_in_place_right_180", "reason": "right 90 missing; right 180 with root-yaw warp scaled to requested angle", "turn_yaw_scale_mode": "match_requested"}}},
  {"id": "state_blend", "kind": "weighted_blend", "inputs_from": "active_players", "normalize": true},
  {"id": "op_root_yaw_offset", "kind": "pose_operation", "operation_type": "rotate_root_yaw",
   "parameter_source": "kinematics.root_yaw_offset_deg"},
  {"id": "op_orientation_warping", "kind": "pose_operation", "operation_type": "orientation_warping",
   "parameter_source": "kinematics.local_velocity_angle_deg minus cardinal angle", "bones_param": "orientation_warp_bones"},
  {"id": "op_stride_warping", "kind": "pose_operation", "operation_type": "stride_warping",
   "parameter_source": "speed / (authored_speed * play_rate)", "note": "leg length scaling intent only; no IK is executed here"},
  {"id": "op_spine_aim", "kind": "pose_operation", "operation_type": "spine_yaw_distribution",
   "parameter_source": "kinematics.aim_offset_deg", "bones_param": "aim_spine_bones", "weights_param": "aim_spine_weights",
   "note": "procedural substitute; no aim-offset assets exist in the manifest"},
  {"id": "output", "kind": "output_pose"}
 ],
 "connections": [
  {"from": "input", "to": "kinematics"},
  {"from": "kinematics", "to": "locomotion_sm"},
  {"from": "locomotion_sm", "to": "player_idle"},
  {"from": "locomotion_sm", "to": "player_start"},
  {"from": "locomotion_sm", "to": "player_cycle"},
  {"from": "locomotion_sm", "to": "player_stop"},
  {"from": "locomotion_sm", "to": "player_pivot"},
  {"from": "locomotion_sm", "to": "player_turn"},
  {"from": "sel_idle", "to": "player_idle"},
  {"from": "sel_start", "to": "player_start"},
  {"from": "sel_cycle", "to": "player_cycle"},
  {"from": "sel_stop", "to": "player_stop"},
  {"from": "sel_pivot", "to": "player_pivot"},
  {"from": "sel_turn", "to": "player_turn"},
  {"from": "player_idle", "to": "state_blend"},
  {"from": "player_start", "to": "state_blend"},
  {"from": "player_cycle", "to": "state_blend"},
  {"from": "player_stop", "to": "state_blend"},
  {"from": "player_pivot", "to": "state_blend"},
  {"from": "player_turn", "to": "state_blend"},
  {"from": "state_blend", "to": "op_root_yaw_offset"},
  {"from": "op_root_yaw_offset", "to": "op_orientation_warping"},
  {"from": "op_orientation_warping", "to": "op_stride_warping"},
  {"from": "op_stride_warping", "to": "op_spine_aim"},
  {"from": "op_spine_aim", "to": "output"}
 ],
 "sync_groups": [
  {"id": "locomotion_cycle", "members_from_nodes": ["player_cycle"],
   "settings": {"method": "marker_phase", "markers": ["foot_l_plant", "foot_r_plant"],
                "phase_reference_marker": "foot_l_plant", "leader_policy": "highest_weight",
                "fallback_method": "normalized_time"}}
 ],
 "output": {"node": "output", "pose_operation_order": ["op_root_yaw_offset", "op_orientation_warping", "op_stride_warping", "op_spine_aim"],
            "root_motion_mode": "capsule_driven_ignore_asset_root_translation",
            "time_contract": "sample_time_seconds is authoritative for every player each frame; play_rate is the rate the controller used to advance that time this frame and must not be re-applied by a consumer."}
}
