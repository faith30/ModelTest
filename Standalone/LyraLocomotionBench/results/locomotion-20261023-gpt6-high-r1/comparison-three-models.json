          }
        ]
      },
      "deepseek": {
        "summary_zh": "提交了可追踪的基础资源加工、四向走跑与姿态操作框架，但许多 Lyra 移动关键机制停留在基础播放层。缺采样的22项没有作为扣分原因。",
