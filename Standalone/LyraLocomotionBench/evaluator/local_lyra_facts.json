    {
      "kind": "context_effect_notify",
      "class": "AnimNotify_LyraContextEffects",
      "effect_tags": [
        "AnimEffect.Footstep.Walk",
        "AnimEffect.Footstep.Land"
      ],
      "purpose_zh": "在动画的相应动作时机发出脚步/落地效果请求。Effect是效果标签，SocketName及bAttached决定附着骨骼/插槽，追踪结果和上下文交给效果系统选择声音或视觉效果。左右骨骼采用角色自身方向。",
      "confirmed_consumers_zh": "Notify在bPerformTrace为真时从插槽或组件位置发起追踪；随后向实现LyraContextEffectsInterface的角色/组件调用AnimMotionEffect，并传递Effect、附着插槽和命中信息。通知触发时间来自动画事件本身；该消费者没有根据脚高度重新决定动画中的打点位置。",
      "naming_boundary_zh": "Walk和Land在这里是效果资源选择标签；消费者没有根据动画文件名将Jog自动变成另一种标签。落地效果不等于同步相位标记。",
      "evidence": [
        {
          "source": "Source/LyraGame/Feedback/ContextEffects/AnimNotify_LyraContextEffects.cpp",
          "line_start": 67,
          "line_end": 77,
          "text": "\t\t\tif (bPerformTrace)\n\t\t\t{\n\t\t\t\t// If trace is needed, set up Start Location to Attached\n\t\t\t\tFVector TraceStart = bAttached ? MeshComp->GetSocketLocation(SocketName) : MeshComp->GetComponentLocation();\n\n\t\t\t\t// Make sure World is valid\n\t\t\t\tif (UWorld* World = OwningActor->GetWorld())\n\t\t\t\t{\n\t\t\t\t\t// Call Line Trace, Pass in relevant properties\n\t\t\t\t\tbHitSuccess = World->LineTraceSingleByChannel(HitResult, TraceStart, (TraceStart + TraceProperties.EndTraceLocationOffset),\n\t\t\t\t\t\tTraceProperties.TraceChannel, QueryParams, FCollisionResponseParams::DefaultResponseParam);"
        },
        {
          "source": "Source/LyraGame/Feedback/ContextEffects/AnimNotify_LyraContextEffects.cpp",
          "line_start": 112,
          "line_end": 117,
          "text": "\t\t\t\t\t// If the object is still valid, Execute the AnimMotionEffect Event on it, passing in relevant data\n\t\t\t\t\tILyraContextEffectsInterface::Execute_AnimMotionEffect(LyraContextEffectImplementingObject,\n\t\t\t\t\t\t(bAttached ? SocketName : FName(\"None\")),\n\t\t\t\t\t\tEffect, MeshComp, LocationOffset, RotationOffset,\n\t\t\t\t\t\tAnimation, bHitSuccess, HitResult, Contexts, VFXProperties.Scale,\n\t\t\t\t\t\tAudioProperties.VolumeMultiplier, AudioProperties.PitchMultiplier);"
        }
      ]
    }
